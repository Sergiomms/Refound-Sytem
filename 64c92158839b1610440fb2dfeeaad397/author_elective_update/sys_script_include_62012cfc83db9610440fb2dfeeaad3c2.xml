        <mobile_callable>false</mobile_callable>
        <name>GetUserGroups</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var GetUserGroups = Class.create();
GetUserGroups.prototype = {
    initialize: function() {},

	getGroups: function() {
        var userId = gs.getUserID(); // Obtém o usuário logado
        var groups = [];

        var gr = new GlideRecord("sys_user_grmember");
        gr.addQuery("user", userId);
        gr.query();

        while (gr.next()) {
            groups.push(gr.group.getDisplayValue()); // Adiciona o nome do grupo ao array
        }

        return groups.join(", "); // Retorna os grupos como string
    },

    type: 'GetUserGroups'
};]]></script>
