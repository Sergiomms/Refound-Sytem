        <mobile_callable>false</mobile_callable>
        <name>GetUserGroup</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var GetUserGroup = Class.create();
GetUserGroup.prototype = {
    initialize: function() {
    },
	getUserGroup: function() {
        var userId = gs.getUserID(); // Obtém o usuário logado
        var gr = new GlideRecord('sys_user_grmember');
        gr.addQuery('user', userId);
        gr.query();

        if (gr.next()) {
            return gr.getValue('group'); // Retorna o primeiro grupo encontrado
        }
        return ''; // Caso o usuário não tenha grupo
    },

    type: 'GetUserGroup'
};]]></script>
